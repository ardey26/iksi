generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model LongURL {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  originalURL String
  urlHash     String?  @unique
  shortURL    String   @unique
  clickCount  Int      @default(0)
  clicks      Click[]

  @@index([createdAt(sort: Desc)])
  @@index([originalURL])
  @@index([clickCount(sort: Desc)])
}

model Click {
  id        BigInt   @id @default(autoincrement())
  urlId     Int
  createdAt DateTime @default(now())
  referrer  String?
  country   String?
  browser   String?
  device    String?
  url       LongURL  @relation(fields: [urlId], references: [id], onDelete: Cascade)

  @@index([urlId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([country])
  @@index([referrer])
  @@index([device])
}

model RateLimit {
  id        String   @id // IP address or identifier
  count     Int      @default(1)
  resetAt   DateTime

  @@index([resetAt])
}
