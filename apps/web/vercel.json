{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.png|favicon.svg|icon-512.png|og-image.png|manifest.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/safe-browsing-sweep",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/expire-secrets",
      "schedule": "30 3 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
